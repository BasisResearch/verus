    LET e_2 == TraceStepAt IN
    [ step_enabled |-> ENABLED (Next /\ TraceStep(e_2)),
      unmatched |-> {k_2 \in DOMAIN TraceStateOf(e_2) :
                        ~ENABLED (Next /\ TraceStep(e_2) /\ TraceObservedKeyNext(k_2, TraceStateOf(e_2)[k_2]))} ]
